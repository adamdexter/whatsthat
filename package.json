{
  "name": "whatsthat",
  "version": "1.11.0",
  "description": "Personalized 1:1 WhatsApp campaign sender with Google Sheets contact import",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "mock": "WHATSTHAT_MOCK=1 node server.js",
    "test": "node --test \"test/*.test.js\"",
    "postinstall": "patch-package",
    "app": "electron .",
    "icons": "electron scripts/make-icons.js",
    "migrate-data": "node scripts/migrate-data.js",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 && node scripts/verify-build.js"
  },
  "dependencies": {
    "@googleapis/sheets": "^14.0.0",
    "@puppeteer/browsers": "2.13.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "googleapis": "^173.0.0",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "net.whatsthat.app",
    "productName": "WhatsThat",
    "copyright": "Adam Dexter",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "app/**",
      "server.js",
      "src/**",
      "scripts/run-due.js",
      "public/**",
      "package.json",
      "!**/*.test.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    }
  }
}
